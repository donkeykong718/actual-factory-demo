# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/

# Claude Code local settings. Pack overlays may intentionally contain
# overlay/.claude/settings.json and should be tracked.
.claude/
!.claude/
.claude/*
!.claude/skills/
!.claude/skills/**
!**/overlay/.claude/
!**/overlay/.claude/**
.vscode/settings.json

# macOS editor/swap tempfiles (e.g. .!PID!filename)
.!*!*

# Scratch review / experiment directories
.tmp/

# Coding-agent review-findings dirs. Automated review tooling writes these at
# the repo root of a working tree. They hold internal run identifiers and raw
# review commentary, so a broad `git add -A` must never sweep them into a PR.
.architect/
.reviewer/
