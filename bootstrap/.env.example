# Copy to .env and edit, then run ./bootstrap.sh <step>
#
#   cp .env.example .env
#
# Every value below has a working default. Change one only if the default
# is wrong for your setup.

# Where the factory directory is created. Defaults to the parent of your
# clone of this repo, which puts factory1/ next to actual-factory-demo/.
# DEMO_PATH=~/factory-demo

# Name of the factory directory. The bootstrap script DELETES this directory
# on every run, so do not point it at anything you care about.
FACTORY_DIR_NAME=factory1

# Name the factory knows the rig by. The rig itself is this repo.
RIG_NAME=ascii-art

# Coding agent the factory drives: claude, codex, or gemini.
MODEL_PROVIDER=claude
